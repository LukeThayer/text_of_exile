// Crafting currency definitions for loot_core
// These can be applied to equipment to modify them
(
    currencies: [
        (
            name: "Orb of Enhancement",
            description: "Improves the quality of an item",
            effect: Enhance,
            drop_weight: 100,
        ),
        (
            name: "Orb of Chaos",
            description: "Randomizes all modifiers on an item",
            effect: Reroll,
            drop_weight: 30,
        ),
        (
            name: "Orb of Augmentation",
            description: "Adds a modifier to a magic item",
            effect: AddAffix,
            drop_weight: 80,
        ),
    ]
)
